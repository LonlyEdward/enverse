# Copy this file to .env and fill in real values. .env is gitignored.
# For local development with docker-compose the POSTGRES_* values below are
# enough; the compose file supplies dev defaults for SECRET_KEY, DEBUG and
# REDIS_URL. Production must set SECRET_KEY and leave DEBUG off.

# --- Core ---
DEBUG=True                     # True in dev only. Default is False (production).
SECRET_KEY=                    # Required when DEBUG is off. Generate a long random string.
ALLOWED_HOSTS=localhost,127.0.0.1   # Comma-separated hostnames Django will serve.
CSRF_TRUSTED_ORIGINS=          # Comma-separated origins WITH scheme, e.g. https://app.example.com
FRONTEND_URL=http://localhost:5173  # Used in email links and as the default CORS origin.
LOG_LEVEL=INFO                 # Root logger level.

# --- Database ---
# Either set DATABASE_URL (preferred on hosted platforms)...
DATABASE_URL=                  # e.g. postgres://user:pass@host:5432/dbname
# ...or the discrete variables below (used by docker-compose locally).
POSTGRES_DB=enversedb
POSTGRES_USER=enverseuser
POSTGRES_PASSWORD=
POSTGRES_HOST=db               # 'db' is the docker-compose service name.
POSTGRES_PORT=5432

# --- Redis (Celery broker on db 0, Django cache on db 1) ---
REDIS_URL=redis://redis:6379/0

# --- CORS ---
CORS_ALLOWED_ORIGINS=          # Comma-separated, no trailing slash. Defaults to FRONTEND_URL.

# --- Throttling / proxies ---
NUM_PROXIES=                   # Number of proxies in front of the app (0 dev, 1 behind one LB).

# --- Production HTTPS (only read when DEBUG is off) ---
SECURE_SSL_REDIRECT=True       # Redirect HTTP to HTTPS.
SECURE_HSTS_SECONDS=3600       # Start small; raise once HTTPS is proven.

# --- Email ---
EMAIL_USE_SMTP=False           # False uses the console backend (dev). True uses SMTP below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=EnVerse <no-reply@enverse.local>

# --- External content APIs (used from Phase 3 onward; blank is fine until then) ---
TMDB_API_KEY=                  # themoviedb.org. If it starts with 'eyJ' it is a v4 Bearer token.
RAWG_API_KEY=                  # rawg.io (games).
API_FOOTBALL_KEY=              # api-football (football fixtures).
